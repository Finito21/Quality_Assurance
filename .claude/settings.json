{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(docs/**)",
      "Edit(hooks/**)",
      "Edit(mkdocs.yml)",
      "Edit(requirements.in)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Bash(mkdocs build*)",
      "Bash(mkdocs serve*)",
      "Bash(python -m mkdocs build*)",
      "Bash(python -m mkdocs serve*)",
      "Bash(python scripts/check_translations.py)",
      "Bash(python -m unittest*)",
      "Edit(scripts/**)",
      "Edit(tests/**)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git branch -a)",
      "Bash(git branch -v*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh auth status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "PowerShell(mkdocs build*)",
      "PowerShell(mkdocs serve*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Content*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(pip install*)",
      "Bash(rm *)",
      "Bash(mv *)",
      "PowerShell(git push*)",
      "PowerShell(Remove-Item*)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(.gitignore)",
      "Edit(LICENSE)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push*--force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh api*-X DELETE*)",
      "Bash(gh secret*)",
      "Bash(gh variable set*)",
      "Bash(gh auth token*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.git-credentials)",
      "Bash(cat*.ssh*)",
      "Bash(cat*.git-credentials*)",
      "Bash(rm -rf*)",
      "Bash(mkdocs gh-deploy*)",
      "Bash(python -m mkdocs gh-deploy*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item*-Recurse*)",
      "PowerShell(mkdocs gh-deploy*)",
      "Bash(cat*.env*)",
      "Bash(cat*.pem*)",
      "Bash(cat*.key*)",
      "Bash(grep*.env*)",
      "Bash(head*.env*)",
      "Bash(head*.pem*)",
      "Bash(head*.key*)",
      "Bash(tail*.env*)",
      "Bash(tail*.pem*)",
      "Bash(tail*.key*)",
      "Bash(grep*.pem*)",
      "Bash(grep*.key*)",
      "PowerShell(Get-Content*.env*)",
      "PowerShell(Get-Content*.pem*)",
      "PowerShell(Get-Content*.key*)",
      "Read(.env)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(requirements.txt)",
      "Edit(.git/**)",
      "Edit(site/**)"
    ]
  }
}
